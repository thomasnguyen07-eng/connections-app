rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. PUBLIC read for image packages (sharing)
    match /imagePackages/{packageId} {
  allow read: if true;  // Anyone can read shared packages
  allow write: if request.auth != null;
}
    
    // 2. Users: own data only + admin full access
    match /users/{userId} {
      // User can read/write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admin (thomasnguyen07@gmail.com) can read AND write all users
      allow read, write: if request.auth != null && 
                          request.auth.token.email == 'thomasnguyen07@gmail.com';
    }
    
    // 3. Reports: community board with admin moderation
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
                    (request.auth.uid == resource.data.userId ||
                     request.auth.token.email == 'thomasnguyen07@gmail.com');
      allow delete: if request.auth != null && 
                    (request.auth.uid == resource.data.userId ||
                     request.auth.token.email == 'thomasnguyen07@gmail.com');
    }
    
  // Pass codes for sponsored users
match /pass_codes/{codeId} {
  // Anyone can read (to check if code exists)
  allow read: if true;
  // Only admin can create passcodes
  allow write: if request.auth != null && 
               request.auth.token.email == 'thomasnguyen07@gmail.com';
  // Any authenticated user can update (redeem) - ONE TIME USE
  allow update: if request.auth != null;
}  
 
    // ====== PAYMENT COLLECTIONS ======
    
    // 6. Premium Payments
    match /premium_payments/{paymentId} {
      allow create: if request.auth != null && 
                     request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && 
                   resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && 
                    resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    
    // 7. PayPal Payments
    match /paypalPayments/{paymentId} {
      allow create: if request.auth != null && 
                     request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && 
                   resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && 
                    resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    
    // 8. QR Payments
    match /qrPayments/{paymentId} {
      allow create: if request.auth != null && 
                     request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && 
                   resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && 
                    resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    
    // 9. Momo Payments
    match /momoPayments/{paymentId} {
      allow create: if request.auth != null && 
                     request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && 
                   resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && 
                    resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    
    // 10. Bank Payments
    match /bankPayments/{paymentId} {
      allow create: if request.auth != null && 
                     request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && 
                   resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && 
                    resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    
    // 11. Bulk Orders
    match /bulkOrders/{orderId} {
      allow create: if request.auth != null && 
                     request.resource.data.sponsorId == request.auth.uid;
      allow read: if request.auth != null && 
                   resource.data.sponsorId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // 12. Premium Subscriptions (RevenueCat integration)
match /premium_subscriptions/{subscriptionId} {
  // Admin can read all subscriptions
  allow read: if request.auth != null && 
               request.auth.token.email == 'thomasnguyen07@gmail.com';
  
  // Users can read/write their own subscriptions
  allow create: if request.auth != null && 
                 request.resource.data.userId == request.auth.uid;
  allow read: if request.auth != null && 
               resource.data.userId == request.auth.uid;
  allow update: if request.auth != null && 
                resource.data.userId == request.auth.uid;
  allow delete: if false;
}
    
    // ============================================
    // SECURITY & MODERATION COLLECTIONS
    // ============================================
    
    // 13. Security Logs - Track security events
    match /security_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && 
                   request.auth.token.email == 'thomasnguyen07@gmail.com';
      allow update: if false;
      allow delete: if request.auth != null && 
                    request.auth.token.email == 'thomasnguyen07@gmail.com';
    }
    
    // 14. Mobile Logs - For debugging
    match /mobile_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && 
                   request.auth.token.email == 'thomasnguyen07@gmail.com';
      allow delete: if request.auth != null && 
                    request.auth.token.email == 'thomasnguyen07@gmail.com';
      allow update: if false;
    }
    
    // 15. Blocked IPs - For IP banning
    match /blocked_ips/{ipId} {
      allow read: if request.auth != null && 
                   request.auth.token.email == 'thomasnguyen07@gmail.com';
      allow write: if request.auth != null && 
                    request.auth.token.email == 'thomasnguyen07@gmail.com';
    }
    
    // 16. Cancellation Surveys - User feedback collection
    match /cancellation_surveys/{surveyId} {
      allow read: if request.auth != null && 
                   request.auth.token.email == 'thomasnguyen07@gmail.com';
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null && 
                    request.auth.token.email == 'thomasnguyen07@gmail.com';
    }

    // 17. Appeal Requests
    match /appeal_requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && 
                   request.auth.token.email == 'thomasnguyen07@gmail.com';
      allow update: if request.auth != null && 
                     request.auth.token.email == 'thomasnguyen07@gmail.com';
    }
    
    // ============================================
    // DEFAULT DENY ALL - KEEP AT THE END
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}